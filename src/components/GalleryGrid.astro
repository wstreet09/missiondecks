---
import { Image, getImage } from 'astro:assets';
import type { GalleryPhoto } from '../lib/gallery/types';

interface Props {
  photos: GalleryPhoto[];
}

const { photos } = Astro.props;

// Pre-generate a large (lightbox) source per photo at build time.
// NOTE (Phase 2): photos without `image` are skipped here, while album.count
// is computed upstream in buildAlbums(). Reconcile in the Drive sync so the
// cache only yields photos that have a downloaded image (count == rendered).
const items = await Promise.all(
  photos
    .filter((p) => p.image)
    .map(async (p) => {
      const full = await getImage({
        src: p.image!,
        width: 1600,
        format: 'webp',
      });
      return { photo: p, fullSrc: full.src };
    })
);
---

<div class="gallery-grid">
  {items.map(({ photo, fullSrc }) => (
    <button
      type="button"
      class="gallery-thumb"
      data-lightbox
      data-full={fullSrc}
      data-alt={photo.alt}
      aria-label={`Open photo: ${photo.alt}`}
    >
      <Image
        src={photo.image!}
        alt={photo.alt}
        width={640}
        height={480}
        widths={[320, 640, 960]}
        sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw"
        class="gallery-thumb-img"
        loading="lazy"
        decoding="async"
      />
    </button>
  ))}
</div>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  @media (min-width: 640px) {
    .gallery-grid { grid-template-columns: repeat(3, 1fr); gap: 16px; }
  }
  @media (min-width: 1024px) {
    .gallery-grid { grid-template-columns: repeat(4, 1fr); }
  }
  .gallery-thumb {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    border-radius: 8px;
    overflow: hidden;
    line-height: 0;
  }
  .gallery-thumb-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .gallery-thumb:hover .gallery-thumb-img,
  .gallery-thumb:focus-visible .gallery-thumb-img {
    transform: scale(1.05);
  }
  .gallery-thumb:focus-visible {
    outline: 2px solid #C5A059;
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery-thumb-img { transition: none; }
    .gallery-thumb:hover .gallery-thumb-img,
    .gallery-thumb:focus-visible .gallery-thumb-img { transform: none; }
  }
</style>
