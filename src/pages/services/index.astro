---
import BaseLayout from '../../components/BaseLayout.astro';
import HeroSection from '../../components/HeroSection.astro';
import Section from '../../components/Section.astro';
import Container from '../../components/Container.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { services } from '../../data/services';
---

<BaseLayout
  title="Our Services | Mission Decks & Design"
  description="Custom decks, outdoor kitchens, pergolas, lighting, fencing, and screened porches. Explore our full range of outdoor living services in the NC Triangle."
>
  <HeroSection
    heading="Our Custom Building Services"
    subtitle="From custom decks to complete backyard transformations, we design and build outdoor spaces that fit your home, lifestyle, and budget."
    image="/images/areas/composite-deck-cable-railing.jpg"
    imageAlt="Range of outdoor living services by Mission Decks & Design"
    compact
  />

  <Section bg="white" padding="sm">
    <Container>
      <Breadcrumbs items={[{ label: 'Services' }]} />
    </Container>
  </Section>

  <Section bg="white" padding="sm">
    <Container width="narrow">
      <div style="max-width: 760px;">
        <h2 class="font-serif text-forest text-3xl lg:text-[2.25rem] mb-5">Outdoor Living, Built to Last</h2>
        <p class="text-bark text-lg leading-relaxed mb-4">
          Mission Decks &amp; Design is a licensed and insured custom deck builder serving Holly Springs, Apex, Cary,
          Fuquay-Varina, Sanford, Raleigh, and the wider NC Triangle. Every project is owner-led and built with
          premium materials &mdash; composite, cedar, and pressure-treated lumber &mdash; engineered for North
          Carolina&rsquo;s heat, humidity, and clay soils.
        </p>
        <p class="text-bark leading-relaxed">
          Whether you&rsquo;re planning a custom deck, an outdoor kitchen, a pergola, a screened porch with Eze-Breeze
          windows, low-voltage lighting, or privacy fencing, we handle design, permitting, and construction from the
          first consultation through final walkthrough. Explore our services below, or
          <a href="/contact/" class="text-cedar font-medium">request a free consultation</a> to talk through your project.
        </p>
      </div>
    </Container>
  </Section>

  <Section bg="white">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map(service => (
          <ServiceCard
            name={service.name}
            description={service.shortDescription}
            href={`/services/${service.slug}/`}
            image={service.image}
          />
        ))}
      </div>
    </Container>
  </Section>

  <CTASection />
</BaseLayout>
