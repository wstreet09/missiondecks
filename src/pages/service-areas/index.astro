---
import BaseLayout from '../../components/BaseLayout.astro';
import HeroSection from '../../components/HeroSection.astro';
import Section from '../../components/Section.astro';
import Container from '../../components/Container.astro';
import LocationCard from '../../components/LocationCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import GoogleMap from '../../components/GoogleMap.astro';
import { locations } from '../../data/locations';
---

<BaseLayout
  title="Service Areas | Mission Decks & Design"
  description="Mission Decks & Design serves Holly Springs, Apex, Cary, Fuquay-Varina, Sanford & Raleigh NC. Custom decks and outdoor living across the Triangle."
>
  <HeroSection
    heading="Serving the NC Triangle"
    subtitle="Custom decks and outdoor living spaces in Holly Springs, Apex, Cary, Fuquay-Varina, Sanford, and Raleigh."
    image="/images/areas/composite-deck-cable-railing.jpg"
    imageAlt="Map of Mission Decks & Design service areas in the NC Triangle"
    compact
  />

  <Section bg="white" padding="sm">
    <Container>
      <Breadcrumbs items={[{ label: 'Service Areas' }]} />
    </Container>
  </Section>

  <Section bg="white" padding="sm">
    <Container width="narrow">
      <div style="max-width: 760px;">
        <h2 class="font-serif text-forest text-3xl lg:text-[2.25rem] mb-5">Custom Decks Across the NC Triangle</h2>
        <p class="text-bark text-lg leading-relaxed mb-4">
          Based in Holly Springs, Mission Decks &amp; Design builds custom decks, outdoor kitchens, pergolas, screened
          porches, and complete backyard transformations throughout the Triangle &mdash; including Apex, Cary,
          Fuquay-Varina, Sanford, and Raleigh. We know the local building departments, HOA requirements, and soil
          conditions in each community, so your project is permitted and engineered correctly the first time.
        </p>
        <p class="text-bark leading-relaxed">
          Choose your city below to see neighborhoods we serve, local project notes, and the outdoor living services
          available in your area. Not sure if we cover your town?
          <a href="/contact/" class="text-cedar font-medium">Get in touch</a> &mdash; we&rsquo;re always expanding across
          the Triangle.
        </p>
      </div>
    </Container>
  </Section>

  <Section bg="white">
    <Container>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {locations.map(location => (
          <LocationCard
            name={location.name}
            neighborhoods={location.neighborhoods}
            href={`/service-areas/${location.slug}/`}
          />
        ))}
      </div>
    </Container>
  </Section>

  <GoogleMap areaName="Holly Springs & the NC Triangle" />

  <CTASection />
</BaseLayout>
